{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@ghal/domain": [
        "./domain/src"
      ],
      "@ghal/process-ir": [
        "./modules/process-ir/src/types.ts"
      ],
      "@ghal/runtime": [
        "./modules/runtime/src/engine.ts"
      ],
      "@ghal/governance": [
        "./modules/governance/src/policy.ts"
      ],
      "@ghal/model-gateway": [
        "./modules/model-gateway/src"
      ],
      "@ghal/audit": [
        "./modules/audit/src"
      ],
      "@ghal/protocols": [
        "./modules/protocols/src/state-machines.ts"
      ],
      "@ghal/ingestion": [
        "./modules/ingestion/src"
      ],
      "@ghal/metrics": [
        "./modules/metrics/src"
      ],
      "@ghal/diagnostics": [
        "./modules/diagnostics/src"
      ],
      "@ghal/redesign": [
        "./modules/redesign/src"
      ],
      "@ghal/outcomes": [
        "./modules/outcomes/src"
      ]
    }
  }
}
