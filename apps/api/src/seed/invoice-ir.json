{
  "ir_version": "1.0",
  "process_id": "00000000-0000-0000-0000-000000000001",
  "version": 1,
  "outcome": {
    "statement": "Pay supplier invoices on time with minimal human intervention and maximum accuracy",
    "kpis": [
      { "name": "cycle_time_hours", "target": 24, "unit": "h" },
      { "name": "exception_rate", "target": 5, "unit": "%" },
      { "name": "auto_approval_rate", "target": 80, "unit": "%" }
    ]
  },
  "modules": [
    {
      "id": "m-intake", "name": "Intake & Capture", "order": 1,
      "steps": [
        {
          "id": "s-receive", "type": "step", "name": "Receive Invoice from Email",
          "actor": { "type": "system", "ref": "email-gateway" },
          "autonomy": "ALLOW", "inputs": [], "outputs": ["invoice_raw"],
          "evidence_required": ["email_original"], "parameters": {},
          "risk": { "level": "low", "reversibility": true },
          "exceptions": [{ "on": "parse_failure", "route": "human" }]
        },
        {
          "id": "s-extract", "type": "step", "name": "Extract & Validate Invoice Data",
          "actor": { "type": "agent", "ref": "invoice-extraction-agent" },
          "autonomy": "SUPERVISED", "inputs": ["invoice_raw"], "outputs": ["invoice_structured"],
          "evidence_required": ["extraction_confidence"],
          "parameters": { "confidence_threshold": 0.8 },
          "risk": { "level": "med", "reversibility": true },
          "exceptions": [{ "on": "low_confidence", "route": "human" }, { "on": "timeout", "route": "retry" }]
        }
      ],
      "transitions": [
        { "from": null, "to": "s-receive" },
        { "from": "s-receive", "to": "s-extract" }
      ]
    },
    {
      "id": "m-validate", "name": "Validation & Matching", "order": 2,
      "steps": [
        {
          "id": "s-po-match", "type": "decision", "name": "Match Invoice with Purchase Order",
          "actor": { "type": "agent", "ref": "matching-agent" },
          "autonomy": "SUPERVISED", "inputs": ["invoice_structured"], "outputs": ["match_result"],
          "evidence_required": ["po_reference"],
          "parameters": { "tolerance_pct": 2 },
          "risk": { "level": "med", "reversibility": true },
          "exceptions": [{ "on": "no_po", "route": "escalate" }, { "on": "mismatch", "route": "human" }]
        }
      ],
      "transitions": [{ "from": "s-extract", "to": "s-po-match" }]
    },
    {
      "id": "m-approve", "name": "Approval", "order": 3,
      "steps": [
        {
          "id": "s-approve", "type": "approval", "name": "Approve Payment",
          "actor": { "type": "human", "ref": "finance_manager" },
          "autonomy": "APPROVAL_REQUIRED", "inputs": ["match_result", "invoice_structured"], "outputs": ["approval"],
          "evidence_required": ["match_result", "invoice_structured"],
          "parameters": { "approval_threshold": 10000, "auto_approve_below": true },
          "risk": { "level": "high", "reversibility": false },
          "exceptions": [{ "on": "timeout", "route": "escalate" }]
        }
      ],
      "transitions": [{ "from": "s-po-match", "to": "s-approve", "condition_param": "amount_gte_threshold" }]
    },
    {
      "id": "m-pay", "name": "Execution", "order": 4,
      "steps": [
        {
          "id": "s-pay", "type": "step", "name": "Execute Payment via ERP",
          "actor": { "type": "system", "ref": "erp-gateway" },
          "autonomy": "ALLOW", "inputs": ["approval"], "outputs": ["payment_confirmation"],
          "evidence_required": ["payment_reference"], "parameters": {},
          "risk": { "level": "high", "reversibility": false },
          "exceptions": [{ "on": "erp_failure", "route": "compensate" }]
        }
      ],
      "transitions": [{ "from": "s-approve", "to": "s-pay" }]
    }
  ],
  "policies": [{ "ref": "pol-financial-approval", "rules": ["r-high", "r-amount"] }],
  "metrics": [
    { "name": "cycle_time_hours", "source": "events" },
    { "name": "exception_rate", "source": "events" },
    { "name": "auto_approval_rate", "source": "events" }
  ],
  "governance": { "audit_level": "full", "approval_points": ["s-approve"] }
}
