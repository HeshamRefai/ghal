{
  "name": "ghal",
  "version": "0.1.0",
  "private": true,
  "description": "G-HAL — Adaptive Process Redesign System for the agentic AI era",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "modules/*",
    "domain"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm -r lint",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}
